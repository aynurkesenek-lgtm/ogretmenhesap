rules_version = '2';
// Firebase Console > Firestore Database > Kurallar (Rules) sekmesine yapıştırın.
// ÖNEMLİ: Aşağıdaki e-posta adresini kendi öğretmen e-postanızla değiştirin
// (firebase-config.js içindeki OGRETMEN_EPOSTA ile aynı olmalı).
service cloud.firestore {
  match /databases/{database}/documents {
    function girisVar() { return request.auth != null; }
    function ogretmen() { return girisVar() && request.auth.token.email == 'ogretmen@ornek.com'; }
    function kendisi(uid) { return girisVar() && request.auth.uid == uid; }
    function aktifOgrenci() {
      return girisVar() && get(/databases/$(database)/documents/kullanicilar/$(request.auth.uid)).data.aktif == true;
    }

    // Öğretmenin kişisel alanı (görevler, notlar, ders programı): yalnızca öğretmen
    match /ogretmen/{uid}/{belge=**} {
      allow read, write: if ogretmen() && kendisi(uid);
    }

    // Öğrenci kayıtları: öğretmen yönetir, öğrenci yalnızca kendi kaydını okur
    match /kullanicilar/{uid} {
      allow read: if ogretmen() || kendisi(uid);
      allow write: if ogretmen();

      // Öğrencinin kişisel yapılacaklar listesi
      match /gorevler/{id} {
        allow read, write: if kendisi(uid) && aktifOgrenci();
      }
    }

    // Duyurular: öğretmen yazar, aktif öğrenciler okur
    match /duyurular/{id} {
      allow read: if ogretmen() || aktifOgrenci();
      allow write: if ogretmen();
    }

    // Ödevler: öğretmen yazar, aktif öğrenciler okur
    match /odevler/{id} {
      allow read: if ogretmen() || aktifOgrenci();
      allow write: if ogretmen();

      // Teslim durumu: her öğrenci yalnızca kendi kaydını yazar
      match /teslim/{ogrenciId} {
        allow read: if ogretmen() || kendisi(ogrenciId);
        allow write: if kendisi(ogrenciId) && aktifOgrenci();
      }
    }
  }
}
